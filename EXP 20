import numpy as np
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_absolute_error, r2_score

X = np.array(range(1, 13)).reshape(-1, 1)
y = np.array([100, 120, 115, 140, 150, 160,
              170, 180, 190, 210, 220, 240])

model = LinearRegression()
model.fit(X, y)

pred = model.predict(X)

print("Actual Sales:", y)
print("Predicted Sales:", np.round(pred, 2))
print("MAE:", mean_absolute_error(y, pred))
print("R2 Score:", r2_score(y, pred))

future_months = np.array([[13], [14], [15]])
future_sales = model.predict(future_months)

for month, sales in zip([13, 14, 15], future_sales):
    print("Predicted Sales for Month", month, ":", round(sales, 2))
