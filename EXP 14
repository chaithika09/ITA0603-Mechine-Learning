import numpy as np
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_absolute_error, r2_score

X = np.array([
    [1000, 2], [1200, 2], [1500, 3], [1800, 3],
    [2000, 4], [2200, 4], [2500, 4], [2800, 5]
])
y = np.array([20, 25, 35, 40, 45, 50, 60, 70])

model = LinearRegression()
model.fit(X, y)

pred = model.predict(X)

print("Actual Prices:", y)
print("Predicted Prices:", np.round(pred, 2))
print("MAE:", mean_absolute_error(y, pred))
print("R2 Score:", r2_score(y, pred))

print("New House Price:", model.predict([[1600, 3]])[0])
